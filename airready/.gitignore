# --- Python / backend / ml ---
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# --- Environment files (never commit secrets) ---
.env
.env.local
backend/.env
frontend/.env.local

# --- Node / frontend ---
node_modules/
dist/
.vite/

# --- ML data & model artifacts (large files, regenerate instead of committing) ---
ml/data/CMAPSS/
ml/models/*.pkl
# metrics.json IS tracked — it's small and useful to diff across experiments
!ml/models/metrics.json

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
