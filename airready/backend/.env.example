# Copy this file to .env and fill in values. Never commit the real .env file.

# Port Uvicorn binds to locally (Render sets $PORT automatically in production)
PORT=8000

# Path to the trained model artifact (see docs/ML.md for how this gets produced)
MODEL_PATH=../ml/models/rul_model.pkl

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173
